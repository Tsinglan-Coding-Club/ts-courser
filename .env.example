# Development defaults use ts_courser.settings. For production set
# DJANGO_SETTINGS_MODULE=ts_courser.settings_production.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=courser.tsinglan.top
DJANGO_CSRF_TRUSTED_ORIGINS=https://courser.tsinglan.top

# Microsoft Entra ID (global cloud). The first two values are public IDs;
# create the secret in Entra and store the real value only in deployment secrets.
MS_ENTRA_TENANT_ID=7222912a-435d-423b-b22b-74b909c3bf8b
MS_ENTRA_CLIENT_ID=5910709e-99db-4cc0-9468-88497aa32f23
MS_ENTRA_CLIENT_SECRET=replace-with-entra-client-secret
MS_ENTRA_SCHOOL_DOMAIN=tsinglan.org
MS_ENTRA_REDIRECT_URI=https://courser.tsinglan.top/accounts/microsoft/callback/
LOCAL_INITIAL_PASSWORD_TTL_DAYS=7

# Production HTTPS settings
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
# Set true only when a trusted reverse proxy sets X-Forwarded-Proto.
DJANGO_USE_PROXY_SSL_HEADER=false
