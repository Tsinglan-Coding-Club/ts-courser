# Development defaults use ts_courser.settings. For production set
# DJANGO_SETTINGS_MODULE=ts_courser.settings_production.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# Production HTTPS settings
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
# Set true only when a trusted reverse proxy sets X-Forwarded-Proto.
DJANGO_USE_PROXY_SSL_HEADER=false
